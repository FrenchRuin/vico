---
import { getOwnerProfile, getSiteData, listOwners, type OwnerProfile } from '../../../lib/data';
import { config } from '../../../vico.config';
import { Footer } from '../../components/Footer';
import { Header } from '../../components/Header';
import { AddProjectCard, CompactProjectRow, ProfileBanner } from '../../components/Profile';
import { ProjectCard } from '../../components/ProjectCard';
import BaseLayout from '../../layouts/BaseLayout.astro';

type Props = { profile: OwnerProfile; nowIso: string; generatedAt: string };

/** 등록 프로젝트가 있는 아이디만 페이지를 만든다. */
export function getStaticPaths() {
  const now = new Date();
  const { projects, generatedAt } = getSiteData(now);
  return listOwners(projects).flatMap((owner) => {
    const profile = getOwnerProfile(projects, owner);
    return profile
      ? [{ params: { id: owner }, props: { profile, nowIso: now.toISOString(), generatedAt } }]
      : [];
  });
}

const { profile, nowIso, generatedAt } = Astro.props;
const now = new Date(nowIso);
const remaining = Math.max(0, config.maxActivePerOwner - profile.ongoing.length);
---

<BaseLayout title={`@${profile.owner} — Vico`} description={`@${profile.owner}의 Vico 프로젝트`}>
  <Header />
  <main class="mx-auto flex max-w-narrow flex-col gap-10 px-gutter pt-8 pb-16">
    <ProfileBanner profile={profile} maxActive={config.maxActivePerOwner} />

    <section aria-labelledby="ongoing-title" class="flex flex-col gap-4">
      <h2 id="ongoing-title" class="text-lg font-bold">진행중인 프로젝트</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {profile.ongoing.map((project) => <ProjectCard project={project} now={now} />)}
        {remaining > 0 && <AddProjectCard remaining={remaining} />}
      </div>
    </section>

    {
      profile.done.length > 0 && (
        <section aria-labelledby="done-title" class="flex flex-col gap-3">
          <h2 id="done-title" class="text-lg font-bold">완성작</h2>
          {profile.done.map((project) => <CompactProjectRow project={project} />)}
        </section>
      )
    }

    {
      profile.dormant.length > 0 && (
        <section aria-labelledby="dormant-title" class="flex flex-col gap-3">
          <h2 id="dormant-title" class="text-base font-bold text-text-sub">휴면</h2>
          {profile.dormant.map((project) => <CompactProjectRow project={project} />)}
        </section>
      )
    }
  </main>
  <Footer generatedAt={generatedAt} />
</BaseLayout>
