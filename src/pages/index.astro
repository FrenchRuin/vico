---
import { getSiteData } from '../../lib/data';
import { getOverviewProjects, getRecentlyChecked } from '../../lib/similar';
import { FinalCta } from '../components/Blocks';
import { CheckedStrip } from '../components/CheckedStrip';
import { Footer } from '../components/Footer';
import { Header } from '../components/Header';
import { Hero } from '../components/Hero';
import { Overview } from '../components/Overview';
import { ProjectBrowser } from '../components/ProjectBrowser';
import BaseLayout from '../layouts/BaseLayout.astro';

const now = new Date();
const { projects, stats, generatedAt } = getSiteData(now);
const { highlight, recruiting } = getOverviewProjects(projects, now);
const checked = getRecentlyChecked(projects, now);
---

<BaseLayout>
  <Header current="projects" />
  <main id="main" tabindex="-1" class="outline-none">
    <Hero highlight={highlight} />
    <CheckedStrip projects={checked} />

    <div class="mx-auto flex max-w-content flex-col gap-16 px-gutter pb-16">
      <Overview stats={stats} highlight={highlight} recruiting={recruiting} now={now} />

      <section id="projects" aria-labelledby="projects-title" class="flex scroll-mt-6 flex-col gap-5">
        <h2 id="projects-title" class="text-[28px] leading-tight font-extrabold tracking-[-0.02em]">
          모든 프로젝트
        </h2>
        <ProjectBrowser client:load projects={projects} nowIso={now.toISOString()} />
      </section>
    </div>

    <FinalCta />
  </main>
  <Footer generatedAt={generatedAt} />
</BaseLayout>
