{
  "name": "vico",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "collect": "tsx scripts/collect.ts",
    "validate": "tsx scripts/validate.ts",
    "maintain": "tsx scripts/maintain.ts",
    "check": "astro check && biome check . && vitest run",
    "format": "biome check --write ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@biomejs/biome"
    ]
  },
  "dependencies": {
    "@astrojs/react": "7.1.7",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.10",
    "gray-matter": "4.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
